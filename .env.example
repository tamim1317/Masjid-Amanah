# Copy to .env.local for Next.js. Never commit real secrets.

# --- Web public (safe for browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Web server only (NEVER prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Ops / local DB tests ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# --- Optional monitoring ---
# SENTRY_DSN=
# LOG_LEVEL=info

# Staging vs production: separate Supabase projects and secret stores.
# See docs/ENVIRONMENTS.md
